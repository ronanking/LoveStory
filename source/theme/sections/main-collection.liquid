          <div class="ls-photo veil-card__img" style="aspect-ratio:3/4;">
            <img src="{{ 'ls-ceremony.jpg' | asset_url }}" alt="Cathedral Veil · Ceremony at the altar" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:50% 20%;">
