<section class="ls-section" id="categories" data-reveal>
  <div class="ls-container">
    <div class="ls-section-header" style="margin-bottom:56px;">
      <div style="display:flex;flex-direction:column;gap:14px;max-width:620px;">
        <div class="ls-eyebrow">The collection</div>
        <h2 class="ls-section-title">
          Four houses of work, <em>one studio</em>.
        </h2>
      </div>
      <a href="{{ routes.collections_url }}/veils" class="btn btn--link">
        Shop everything {%- render 'icon-arrow-right', size: 14 -%}
      </a>
    </div>

    <div class="category-grid">

      {%- for block in section.blocks -%}
        <a
          href="{{ block.settings.link | default: routes.collections_url | append: '/veils' }}"
          class="category-card{% if forloop.index == 1 %} category-card--tall{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="ls-photo category-card__img" style="aspect-ratio:{% if forloop.index == 1 %}3/5{% else %}1/1{% endif %};">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.image.alt | default: block.settings.name }}"
                loading="lazy"
                style="object-position: {{ block.settings.focal | default: '50% 40%' }};"
              >
            {%- endif -%}
            <span class="ls-photo__eyebrow">0{{ forloop.index }}</span>
          </div>
          <div class="category-card__body">
            <h3 class="category-card__title">{{ block.settings.name }}</h3>
            <p class="category-card__blurb">{{ block.settings.blurb }}</p>
            <div class="category-card__footer">
              <span class="category-card__count">{{ block.settings.count }}</span>
              <span style="color:var(--ls-ink-60);">{%- render 'icon-arrow-up-right', size: 14 -%}</span>
            </div>
          </div>
        </a>
      {%- else -%}
        {%- comment -%} Placeholder cards shown until blocks are added in the theme editor {%- endcomment -%}
        <a href="/collections/veils" class="category-card category-card--tall">
          <div class="ls-photo category-card__img" style="aspect-ratio:3/5;">
            <img src="{{ 'ls-veil-back.jpg' | asset_url }}" alt="Custom Veils" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:50% 25%;">
            <span class="ls-photo__eyebrow">01</span>
          </div>
          <div class="category-card__body">
            <h3 class="category-card__title">Custom Veils</h3>
            <p class="category-card__blurb">Cathedral · chapel · fingertip — drafted to your gown.</p>
            <div class="category-card__footer">
              <span class="category-card__count">Made-to-order · European tulle</span>
              <span style="color:var(--ls-ink-60);">{%- render 'icon-arrow-up-right', size: 14 -%}</span>
            </div>
          </div>
        </a>
        <a href="/collections/veils" class="category-card">
          <div class="ls-photo category-card__img" style="aspect-ratio:1/1;">
            <img src="{{ 'ls-golden-lace.jpg' | asset_url }}" alt="Pearl Earrings" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:50% 30%;">
            <span class="ls-photo__eyebrow">02</span>
          </div>
          <div class="category-card__body">
            <h3 class="category-card__title">Pearl Earrings</h3>
            <p class="category-card__blurb">Freshwater pearls and a quiet weight of gold — earrings to wear long after the day.</p>
            <div class="category-card__footer">
              <span class="category-card__count">Bridal · everyday</span>
              <span style="color:var(--ls-ink-60);">{%- render 'icon-arrow-up-right', size: 14 -%}</span>
            </div>
          </div>
        </a>
        <a href="/collections/veils" class="category-card">
          <div class="ls-photo category-card__img" style="aspect-ratio:1/1;">
            <img src="{{ 'ls-ceremony.jpg' | asset_url }}" alt="Bridal Accessories" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:50% 20%;">
            <span class="ls-photo__eyebrow">03</span>
          </div>
          <div class="category-card__body">
            <h3 class="category-card__title">Bridal Accessories</h3>
            <p class="category-card__blurb">Hair pins, combs, and silk ribbons — a final considered detail for the morning of.</p>
            <div class="category-card__footer">
              <span class="category-card__count">Hair · Hands · Hem</span>
              <span style="color:var(--ls-ink-60);">{%- render 'icon-arrow-up-right', size: 14 -%}</span>
            </div>
          </div>
        </a>
        <a href="/pages/custom" class="category-card">
          <div class="ls-photo category-card__img" style="aspect-ratio:1/1;">
            <img src="{{ 'ls-lace-closeup.jpg' | asset_url }}" alt="Embroidered Keepsakes" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:50% 35%;">
            <span class="ls-photo__eyebrow">04</span>
          </div>
          <div class="category-card__body">
            <h3 class="category-card__title">Embroidered Keepsakes</h3>
            <p class="category-card__blurb">Initials, a date, a line from your vows — hand-stitched into the piece you'll keep.</p>
            <div class="category-card__footer">
              <span class="category-card__count">Custom · Heirloom</span>
              <span style="color:var(--ls-ink-60);">{%- render 'icon-arrow-up-right', size: 14 -%}</span>
            </div>
          </div>
        </a>
      {%- endfor -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Categories",
  "tag": "div",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text",         "id": "name",  "label": "Category name" },
        { "type": "textarea",     "id": "blurb", "label": "Description" },
        { "type": "text",         "id": "count", "label": "Subtitle / count" },
        { "type": "url",          "id": "link",  "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text",         "id": "focal", "label": "Image focal (e.g. 50% 40%)", "default": "50% 40%" }
      ]
    }
  ],
  "presets": [
    { "name": "Categories" }
  ]
}
{% endschema %}
