<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body style="display:flex;align-items:center;justify-content:center;min-height:100vh;background:var(--ls-cream);">
  <div style="text-align:center;padding:60px 24px;max-width:480px;">
    <p class="ls-eyebrow" style="margin-bottom:16px;">Coming Soon</p>
    <h1 style="font-family:var(--ls-font-display);font-size:clamp(32px,5vw,52px);font-weight:400;color:var(--ls-charcoal);margin:0 0 16px;">{{ shop.name }}</h1>
    <p style="font-size:15px;color:var(--ls-ink-60);margin:0 0 40px;">{{ 'general.password_page.login_prompt' | t }}</p>
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p style="color:#c0392b;font-size:14px;margin-bottom:16px;">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div style="display:flex;gap:8px;max-width:360px;margin:0 auto;">
        <input
          type="password"
          name="password"
          id="Password"
          placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
          style="flex:1;padding:12px 16px;border:1px solid var(--ls-champagne);border-radius:4px;font-size:14px;background:white;color:var(--ls-charcoal);"
          autofocus
        >
        <button type="submit" class="btn btn--primary btn--md">
          {{ 'general.password_page.login_form_submit' | t }}
        </button>
      </div>
    {%- endform -%}
  </div>
</body>
</html>
