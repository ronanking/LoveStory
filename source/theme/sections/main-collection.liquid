<section class="ls-section" style="padding-top:80px;padding-bottom:120px;">
  <div class="ls-container">

    <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:40px;flex-wrap:wrap;">
      <div style="display:flex;flex-direction:column;gap:6px;">
        {%- assign piece_word = 'pieces' -%}
        {%- if collection.products_count == 1 -%}{%- assign piece_word = 'piece' -%}{%- endif -%}
        <div class="ls-eyebrow" data-veil-count>The collection · {{ collection.products_count }} {{ piece_word }}</div>
        <p style="font-size:14px;color:var(--ls-muted);">Each silhouette is a starting point — every piece is then drafted to your gown.</p>
      </div>
      <div class="veils-filters" data-veils-filter>
        {%- assign filters = "All silhouettes,Cathedral,Chapel,Fingertip,Mantilla,Two-tier,Lace,Plain" | split: "," -%}
        {%- for f in filters -%}
          <button
            class="filter-chip{% if forloop.first %} active{% endif %}"
            data-filter="{{ f }}"
            aria-pressed="{{ forloop.first }}"
            type="button"
          >{{ f }}</button>
        {%- endfor -%}
      </div>
    </div>

    <div class="veils-grid">
      {%- for product in collection.products -%}
        {%- assign tags_str = product.tags | join: "," -%}
        <a
          href="{{ product.url }}"
          class="veil-card"
          data-veil-card
          data-tags="{{ tags_str }}"
        >
          <div class="ls-photo veil-card__img" style="aspect-ratio:3/4;">
            {%- if product.featured_image != blank -%}
              <img
                src="{{ product.featured_image | image_url: width: 800 }}"
                alt="{{ product.featured_image.alt | default: product.title }}"
                loading="lazy"
                style="object-position:{{ product.metafields.atelier.focal | default: '50% 40%' }};"
              >
              <span class="ls-photo__eyebrow">{{ product.tags | first }}</span>
            {%- endif -%}
          </div>
          <div class="veil-card__body">
            <h3 class="veil-card__name">{{ product.title }}</h3>
            <div class="veil-card__silhouette">{{ product.metafields.atelier.silhouette | default: product.type }}</div>
            <div class="veil-card__edge">
              Finished with <em>{{ product.metafields.atelier.edge | default: 'hand-finished edge' }}</em>
            </div>
            <div class="veil-card__footer">
              <span class="veil-card__mto">
                {%- if product.price == 0 -%}
                  Made to order
                {%- else -%}
                  From {{ product.price | money }}
                {%- endif -%}
              </span>
              <span style="color:var(--ls-ink-60);">{%- render 'icon-arrow-up-right', size: 13 -%}</span>
            </div>
          </div>
        </a>
      {%- else -%}
        <a href="/pages/contact#enquiry" class="veil-card" data-veil-card data-tags="Cathedral,Lace">
          <div class="ls-photo veil-card__img" style="aspect-ratio:3/4;">
            <img src="{{ 'ls-bride-cathedral.jpg' | asset_url }}" alt="Cathedral Veil · Soft silk tulle" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:50% 20%;">
            <span class="ls-photo__eyebrow">Cathedral</span>
          </div>
          <div class="veil-card__body">
            <h3 class="veil-card__name">Cathedral Veil · Golden Hour</h3>
            <div class="veil-card__silhouette">Cathedral · 300 cm</div>
            <div class="veil-card__edge">Finished with <em>soft cut edge</em></div>
            <div class="veil-card__footer"><span class="veil-card__mto">Made to order</span><span style="color:var(--ls-ink-60);">{%- render 'icon-arrow-up-right', size: 13 -%}</span></div>
          </div>
        </a>
        <a href="/pages/contact#enquiry" class="veil-card" data-veil-card data-tags="Mantilla,Lace">
          <div class="ls-photo veil-card__img" style="aspect-ratio:3/4;">
            <img src="{{ 'ls-golden-lace.jpg' | asset_url }}" alt="Mantilla Veil · Full Chantilly lace" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:50% 30%;">
            <span class="ls-photo__eyebrow">Mantilla</span>
          </div>
          <div class="veil-card__body">
            <h3 class="veil-card__name">Mantilla · Full Lace Trim</h3>
            <div class="veil-card__silhouette">Mantilla · 220 cm</div>
