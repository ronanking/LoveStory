<section class="ls-section ls-section--veil" id="gallery" data-reveal>
  <div class="ls-container">
    <div class="ls-section-header" style="margin-bottom:40px;">
      <div style="display:flex;flex-direction:column;gap:14px;max-width:620px;">
        <div class="ls-eyebrow">Recently in the atelier</div>
        <h2 class="ls-section-title">
          Veils we've made for <em>real brides</em>.
        </h2>
        <p class="ls-section-body">
          A small look-book of recent pieces, each designed around a different gown. No two are the same.
        </p>
      </div>

      {%- comment -%} Filter chips {%- endcomment -%}
      <div style="display:flex;gap:8px;flex-wrap:wrap;" data-gallery-filter>
        {%- assign filters = "All,Cathedral,Mantilla,Two-tier,Lace edge,Plain edge" | split: "," -%}
        {%- for f in filters -%}
          <button
            class="filter-chip{% if forloop.first %} active{% endif %}"
            data-filter="{{ f }}"
            aria-pressed="{{ forloop.first }}"
            type="button"
          >{{ f }}</button>
        {%- endfor -%}
      </div>
    </div>

    <div class="gallery-grid">
      {%- for block in section.blocks -%}
        <figure
          class="gallery-card"
          data-gallery-card
          data-tags="{{ block.settings.tags }}"
          {{ block.shopify_attributes }}
        >
          <div class="ls-photo" style="aspect-ratio:{{ block.settings.aspect | default: '4/5' }};">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.style }}"
                loading="lazy"
                style="width:100%;height:100%;object-fit:cover;object-position:{{ block.settings.focal | default: '50% 40%' }};"
              >
            {%- endif -%}
            <span class="ls-photo__eyebrow">{{ block.settings.tags | split: "," | first }}</span>
            <div class="gallery-hover">
              <div>
                <div class="gallery-hover__title">{{ block.settings.style }}</div>
                <div class="gallery-hover__sub">{{ block.settings.setting }}</div>
              </div>
            </div>
          </div>
        </figure>
      {%- else -%}
        <figure class="gallery-card" data-gallery-card data-tags="Cathedral,Plain edge">
          <div class="ls-photo" style="aspect-ratio:4/5;">
            <img src="{{ 'ls-bride-cathedral.jpg' | asset_url }}" alt="Cathedral veil bride golden hour" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:50% 20%;">
            <span class="ls-photo__eyebrow">Cathedral</span>
            <div class="gallery-hover"><div><div class="gallery-hover__title">Cathedral · Plain edge</div><div class="gallery-hover__sub">Soft silk tulle · golden hour</div></div></div>
          </div>
        </figure>
        <figure class="gallery-card" data-gallery-card data-tags="Mantilla,Lace edge">
          <div class="ls-photo" style="aspect-ratio:4/5;">
            <img src="{{ 'ls-golden-lace.jpg' | asset_url }}" alt="Mantilla veil lace edge golden hour couple" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:50% 30%;">
            <span class="ls-photo__eyebrow">Mantilla</span>
            <div class="gallery-hover"><div><div class="gallery-hover__title">Mantilla · Chantilly lace</div><div class="gallery-hover__sub">Golden hour · full lace trim</div></div></div>
          </div>
        </figure>
        <figure class="gallery-card" data-gallery-card data-tags="Two-tier,Lace edge">
          <div class="ls-photo" style="aspect-ratio:4/5;">
            <img src="{{ 'ls-portrait-bw.jpg' | asset_url }}" alt="Two-tier chapel veil by window" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:50% 20%;">
            <span class="ls-photo__eyebrow">Two-tier</span>
            <div class="gallery-hover"><div><div class="gallery-hover__title">Two-tier · Chapel</div><div class="gallery-hover__sub">Lace edge · European tulle</div></div></div>
          </div>
        </figure>
        <figure class="gallery-card" data-gallery-card data-tags="Lace edge">
          <div class="ls-photo" style="aspect-ratio:4/5;">
            <img src="{{ 'ls-lace-closeup.jpg' | asset_url }}" alt="Chantilly lace edge veil detail" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:50% 35%;">
            <span class="ls-photo__eyebrow">Lace edge</span>
            <div class="gallery-hover"><div><div class="gallery-hover__title">Chantilly lace edge</div><div class="gallery-hover__sub">Hand-finished · custom trim</div></div></div>
          </div>
        </figure>
        <figure class="gallery-card" data-gallery-card data-tags="Mantilla,Lace edge">
          <div class="ls-photo" style="aspect-ratio:4/5;">
            <img src="{{ 'ls-church-veil.jpg' | asset_url }}" alt="Mantilla veil lace edge church light" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:50% 25%;">
            <span class="ls-photo__eyebrow">Mantilla</span>
            <div class="gallery-hover"><div><div class="gallery-hover__title">Mantilla · Lace trim</div><div class="gallery-hover__sub">Church light · dramatic drape</div></div></div>
          </div>
        </figure>
        <figure class="gallery-card" data-gallery-card data-tags="Cathedral,Lace edge">
          <div class="ls-photo" style="aspect-ratio:4/5;">
            <img src="{{ 'ls-ceremony.jpg' | asset_url }}" alt="Cathedral veil at ceremony altar" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:50% 20%;">
            <span class="ls-photo__eyebrow">Cathedral</span>
            <div class="gallery-hover"><div><div class="gallery-hover__title">Cathedral · Lace edge</div><div class="gallery-hover__sub">Ceremony · floral arch</div></div></div>
          </div>
        </figure>
      {%- endfor -%}
    </div>

    <div style="display:flex;justify-content:center;margin-top:48px;">
      <a href="{{ routes.collections_url }}/veils" class="btn btn--ghost btn--lg">
        See the full collection {%- render 'icon-arrow-right', size: 14 -%}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gallery",
  "tag": "div",
  "blocks": [
    {
      "type": "photo",
      "name": "Gallery photo",
      "settings": [
        { "type": "image_picker", "id": "image",   "label": "Photo" },
        { "type": "text",         "id": "style",   "label": "Veil style (hover title)" },
        { "type": "text",         "id": "setting", "label": "Setting (hover subtitle)" },
        { "type": "text",         "id": "tags",    "label": "Filter tags (comma-separated, e.g. Cathedral,Lace edge)" },
        { "type": "text",         "id": "focal",   "label": "Focal point (e.g. 55% 35%)", "default": "50% 40%" },
        { "type": "text",         "id": "aspect",  "label": "Aspect ratio (e.g. 4/5, 3/4, 1/1)", "default": "4/5" }
      ]
    }
  ],
  "presets": [
    { "name": "Gallery" }
  ]
}
{% endschema %}
