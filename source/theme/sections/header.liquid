{%- if section.settings.show_announcement -%}
<div class="announce-bar" role="region" aria-label="Announcements">
  <button class="announce-bar__btn announce-bar__prev" aria-label="Previous announcement">
    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m15 6-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <div class="announce-bar__messages" aria-live="polite">
    {%- assign announcements = section.settings.announcements | split: "|" -%}
    {%- for msg in announcements -%}
      <span class="announce-bar__msg">{{ msg | strip }}</span>
    {%- endfor -%}
  </div>
  <button class="announce-bar__btn announce-bar__next" aria-label="Next announcement">
    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m9 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <div class="announce-bar__right">
    <span>AUD ⌄</span>
    <span>EN</span>
  </div>
</div>
{%- endif -%}

<header class="site-nav" id="SiteNav">
  <div class="site-nav__inner">

    {%- comment -%} Brand {%- endcomment -%}
    <a href="{{ routes.root_url }}" class="site-nav__brand" aria-label="{{ shop.name }}">
      <div class="site-nav__brand-name">Love<em>story</em></div>
      <div class="site-nav__brand-sub">Atelier · Brisbane</div>
    </a>

    {%- comment -%} Desktop nav links {%- endcomment -%}
    <nav aria-label="Main navigation">
      <ul class="nav-links" role="list">
        <li><a href="{{ routes.collections_url }}/veils" class="nav-link" {% if request.path contains '/collections/veils' %}aria-current="page"{% endif %}>Veils</a></li>
        <li><a href="{{ pages['custom'].url | default: '/pages/custom' }}" class="nav-link" {% if request.path contains '/pages/custom' %}aria-current="page"{% endif %}>Custom</a></li>
        <li><a href="{{ pages['about'].url | default: '/pages/about' }}" class="nav-link" {% if request.path contains '/pages/about' %}aria-current="page"{% endif %}>About</a></li>
        <li><a href="{{ pages['contact'].url | default: '/pages/contact' }}" class="nav-link" {% if request.path contains '/pages/contact' %}aria-current="page"{% endif %}>Contact</a></li>
      </ul>
    </nav>

    {%- comment -%} Right side icons + CTA {%- endcomment -%}
    <div class="site-nav__right">
      <a href="{{ routes.search_url }}" class="icon-btn" aria-label="Search">
        {%- render 'icon-search', size: 16 -%}
      </a>
      <a href="{{ routes.cart_url }}" class="icon-btn" aria-label="Cart ({{ cart.item_count }} items)">
        {%- render 'icon-bag', size: 16 -%}
      </a>
      <a href="/pages/contact#enquiry" class="btn btn--primary btn--sm" style="margin-left: 4px;">
        Enquire
      </a>
      <button class="nav-mobile-toggle icon-btn" aria-label="Open menu" aria-expanded="false" aria-controls="MobileNav">
        <span class="icon-menu">{%- render 'icon-search', size: 18 -%}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1"><path d="M4 8h16M4 16h16" stroke-linecap="round"/></svg>
        </span>
        <span class="icon-close" style="display:none;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1"><path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"/></svg>
        </span>
      </button>
    </div>

  </div>
</header>

{%- comment -%} Mobile nav overlay {%- endcomment -%}
<nav class="mobile-nav" id="MobileNav" aria-label="Mobile navigation" aria-hidden="true">
  <a href="{{ routes.collections_url }}/veils" class="mobile-nav__link">Veils</a>
  <a href="{{ pages['custom'].url | default: '/pages/custom' }}" class="mobile-nav__link">Custom</a>
  <a href="{{ pages['about'].url | default: '/pages/about' }}" class="mobile-nav__link">About</a>
  <a href="{{ pages['contact'].url | default: '/pages/contact' }}" class="mobile-nav__link">Contact</a>
  <div class="mobile-nav__cta">
    <a href="/pages/contact#enquiry" class="btn btn--primary btn--lg" style="width:100%;justify-content:center;">
      Enquire — start your veil
    </a>
  </div>
</nav>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": false
    },
    {
      "type": "text",
      "id": "announcements",
      "label": "Announcements (separate with |)",
      "default": "Complimentary express worldwide shipping on orders over $300 AUD | Bespoke bridal veils · handmade in our Brisbane studio | Now booking SS26 wedding-date fittings — enquire to reserve"
    }
  ]
}
{% endschema %}
