# Copy to .env.local and fill in. Names only — never commit real values.
# The application builds and runs with every one of these unset.

# Canonical/OG base URL. No trailing slash.
# Local: http://localhost:3000   Production: https://lovestoryatelier.com
NEXT_PUBLIC_SITE_URL=

# Enquiry email delivery (Resend). Leave blank and the enquiry route reports a
# clear failure instead of showing a false success — never pretend a message
# was sent when it was not.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=info@lovestoryatelier.com

# Must be a sender address on a domain verified in Resend.
ENQUIRY_FROM_EMAIL=

# Privacy-conscious analytics. Disabled entirely until an ID is set.
NEXT_PUBLIC_ANALYTICS_ID=
