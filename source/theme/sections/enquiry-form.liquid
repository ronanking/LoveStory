<section class="ls-section" id="enquiry" data-reveal>
  <div class="ls-container">
    <div class="enquiry-shell">

      {%- comment -%} Left aside {%- endcomment -%}
      <aside class="enquiry-aside">
        <div class="ls-eyebrow">Begin the conversation</div>
        <h2 class="enquiry-aside__title">
          Bespoke Quote <em>Request</em>
        </h2>
        <p class="enquiry-aside__body">
          Thank you for your interest in a bespoke design from Love Story Atelier.
        </p>
        <p class="enquiry-aside__body">
          As an independent designer, I take great pride in creating veils and accessories that are as individual as the brides I work with. Each piece is thoughtfully designed and meticulously handcrafted by me to celebrate your story and reflect your personal style.
        </p>
        <p class="enquiry-aside__body">
          I personally respond to every enquiry and strive to ensure each bride receives the time and consideration her design deserves. With this in mind, please allow <em>7-10 days for a response.</em>
        </p>

        <div class="ls-photo" style="border-radius:12px;border:1px solid var(--ls-border);aspect-ratio:5/6;max-width:360px;">
          {%- if section.settings.aside_image != blank -%}
            <img src="{{ section.settings.aside_image | image_url: width: 720 }}" alt="A recent piece from the atelier" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:55% 30%;">
          {%- else -%}
            <img src="{{ 'ls-mirror.jpg' | asset_url }}" alt="A recent piece from the atelier" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:50% 20%;">
          {%- endif -%}
          <span class="ls-photo__eyebrow">A recent piece</span>
        </div>

        <ul style="list-style:none;display:flex;flex-direction:column;gap:12px;font-size:13.5px;color:var(--ls-ink-82);">
          <li style="display:flex;align-items:center;gap:10px;">
            <span style="width:18px;height:18px;border-radius:9999px;border:1px solid var(--ls-border-strong);display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">{%- render 'icon-check', size: 10 -%}</span>
            <span>Designs and quotes return within 7-10 days</span>
          </li>
          <li style="display:flex;align-items:center;gap:10px;">
            <span style="width:18px;height:18px;border-radius:9999px;border:1px solid var(--ls-border-strong);display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">{%- render 'icon-check', size: 10 -%}</span>
            <span>No deposit until you have seen a sketch</span>
          </li>
          <li style="display:flex;align-items:center;gap:10px;">
            <span style="width:18px;height:18px;border-radius:9999px;border:1px solid var(--ls-border-strong);display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">{%- render 'icon-check', size: 10 -%}</span>
            <span>Final payment held until the veil ships</span>
          </li>
        </ul>
      </aside>

      {%- comment -%} Right — Shopify contact form {%- endcomment -%}
      <div class="enquiry-card">
        {%- form 'contact', id: 'EnquiryForm' -%}

          {%- if form.posted_successfully? -%}
            <div style="display:flex;flex-direction:column;gap:24px;padding:40px 0;align-items:flex-start;">
              <span style="width:56px;height:56px;border-radius:9999px;background:var(--ls-blush-soft);border:1px solid var(--ls-border);display:inline-flex;align-items:center;justify-content:center;color:var(--ls-charcoal);">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 7 9-7"/></svg>
              </span>
              <div class="ls-eyebrow">Enquiry received</div>
              <h3 style="font-family:var(--ls-font-display);font-size:36px;font-weight:500;letter-spacing:-0.8px;line-height:1.08;color:var(--ls-charcoal);">
                Thank you.<br>Your veil starts now.
              </h3>
              <p style="font-size:16px;line-height:1.6;color:var(--ls-ink-82);max-width:520px;">
                We have received your enquiry and will reply within 7-10 days with a written sketch and quote.
                In the meantime, follow along on Instagram and TikTok @lovestoryatelier for behind-the-scenes, real bride features, and inspiration.
              </p>
              <p style="font-size:16px;font-style:italic;color:var(--ls-ink-82);">Jess x</p>
            </div>
          {%- else -%}

            <div style="display:flex;flex-direction:column;gap:40px;">

              {%- comment -%} 01 — Your details {%- endcomment -%}
              <div class="form-section">
                <div class="form-section-header">
                  <span class="form-section-num">01</span>
                  <h3 class="form-section-title">Your details</h3>
                  <div class="form-section-rule"></div>
                </div>
                <div class="form-row">
                  <div class="form-field">
                    <label class="form-label" for="contact_first_name">First Name <span style="color:var(--ls-blush);">*</span></label>
                    <input class="form-input" type="text" id="contact_first_name" name="contact[first name]" placeholder="Please provide your first name" required>
                  </div>
                  <div class="form-field">
                    <label class="form-label" for="contact_last_name">Last Name <span style="color:var(--ls-blush);">*</span></label>
                    <input class="form-input" type="text" id="contact_last_name" name="contact[last name]" placeholder="Please provide your last name" required>
                  </div>
                  <div class="form-field form-field--full">
                    <label class="form-label" for="contact_email">Email <span style="color:var(--ls-blush);">*</span></label>
                    <input class="form-input" type="email" id="contact_email" name="contact[email]" placeholder="Please provide your email address" required>
                  </div>
                  <div class="form-field">
                    <label class="form-label" for="contact_country">Country <span style="color:var(--ls-blush);">*</span></label>
                    <input class="form-input" type="text" id="contact_country" name="contact[country]" placeholder="Country your item will be shipped to" required>
                  </div>
                  <div class="form-field">
                    <label class="form-label" for="contact_phone">Phone</label>
                    <input class="form-input" type="tel" id="contact_phone" name="contact[phone]" placeholder="Optional">
                  </div>
                  <div class="form-field form-field--full">
                    <label class="form-label" for="contact_social">Social media handle</label>
                    <input class="form-input" type="text" id="contact_social" name="contact[social media handle]" placeholder="Optional — if you would like to connect">
                  </div>
                </div>
              </div>

              {%- comment -%} 02 — Your event {%- endcomment -%}
              <div class="form-section">
                <div class="form-section-header">
                  <span class="form-section-num">02</span>
                  <h3 class="form-section-title">Your event</h3>
                  <div class="form-section-rule"></div>
                </div>
                <div class="form-row">
                  <div class="form-field">
                    <label class="form-label" for="contact_event_type">What is your event? <span style="color:var(--ls-blush);">*</span></label>
                    <div style="position:relative;">
                      <select class="form-select" id="contact_event_type" name="contact[event type]" required style="padding-right:28px;">
                        <option value="" disabled selected>Select</option>
                        <option>Wedding</option>
                        <option>Engagement</option>
                        <option>Formal Event</option>
                        <option>Photoshoot</option>
                        <option>Other</option>
                      </select>
                      <span style="position:absolute;right:0;top:50%;transform:translateY(-50%);color:var(--ls-ink-60);pointer-events:none;">{%- render 'icon-chevron-down', size: 14 -%}</span>
                    </div>
                  </div>
                  <div class="form-field">
                    <label class="form-label" for="contact_wedding_date">Wedding Date (or event date)? <span style="color:var(--ls-blush);">*</span></label>
                    <input class="form-input" type="date" id="contact_wedding_date" name="contact[wedding date]" required>
                  </div>
                  <div class="form-field form-field--full">
                    <label class="form-label" for="contact_venue">Wedding Venue / Destination</label>
                    <input class="form-input" type="text" id="contact_venue" name="contact[wedding venue]" placeholder="Helps me understand whether your event is outdoors, in a church, formal or relaxed">
                  </div>
                  <div class="form-field form-field--full">
                    <label class="form-label" style="margin-bottom:10px;">If you are interested in additional accessories, please select them below.</label>
                    <div style="display:flex;flex-direction:column;gap:10px;">
                      <label style="display:flex;align-items:center;gap:10px;font-size:14px;cursor:pointer;"><input type="checkbox" data-group="accessories" value="Gloves/Sleeves" style="flex-shrink:0;"> <span>Gloves/Sleeves</span></label>
                      <label style="display:flex;align-items:center;gap:10px;font-size:14px;cursor:pointer;"><input type="checkbox" data-group="accessories" value="Bridal Scarf" style="flex-shrink:0;"> <span>Bridal Scarf</span></label>
                      <label style="display:flex;align-items:center;gap:10px;font-size:14px;cursor:pointer;"><input type="checkbox" data-group="accessories" value="Capes / Capelets" style="flex-shrink:0;"> <span>Capes / Capelets</span></label>
                      <label style="display:flex;align-items:center;gap:10px;font-size:14px;cursor:pointer;"><input type="checkbox" data-group="accessories" value="Bridal Bag / Clutch" style="flex-shrink:0;"> <span>Bridal Bag / Clutch</span></label>
                      <label style="display:flex;align-items:center;gap:10px;font-size:14px;cursor:pointer;"><input type="checkbox" data-group="accessories" value="Other" style="flex-shrink:0;"> <span>Other</span></label>
                    </div>
                    <input type="hidden" name="contact[accessories interested in]" id="accessories_val">
                  </div>
                </div>
              </div>

              {%- comment -%} 03 — Gown Details {%- endcomment -%}
              <div class="form-section">
                <div class="form-section-header">
                  <span class="form-section-num">03</span>
                  <h3 class="form-section-title"><em>Gown Details</em></h3>
                  <div class="form-section-rule"></div>
                </div>
                <p style="font-size:14px;color:var(--ls-ink-82);margin-bottom:20px;line-height:1.6;">Sharing the details of your gown will help me design a veil that perfectly complements its style, silhouette, and overall aesthetic.</p>
                <div class="form-row">
                  <div class="form-field form-field--full">
                    <label class="form-label" for="contact_designer">Designer (if known):</label>
                    <input class="form-input" type="text" id="contact_designer" name="contact[gown designer]" placeholder="Eg. by KYHA, Aleena Leena, Vera Wang, Steven Khalil">
                  </div>
                  <div class="form-field form-field--full">
                    <label class="form-label" for="contact_style">Style Name / Number (if known):</label>
                    <input class="form-input" type="text" id="contact_style" name="contact[gown style name]">
                  </div>
                </div>
              </div>

              {%- comment -%} 04 — Veil Vision {%- endcomment -%}
              <div class="form-section">
                <div class="form-section-header">
                  <span class="form-section-num">04</span>
                  <h3 class="form-section-title"><em>Veil Vision + Inspiration</em></h3>
                  <div class="form-section-rule"></div>
                </div>
                <p style="font-size:14px;color:var(--ls-ink-82);margin-bottom:20px;line-height:1.6;">Please share as much detail as you can — this will help me tailor your proposal thoughtfully and provide accurate pricing based on your vision.</p>
                <div style="display:flex;flex-direction:column;gap:24px;">
                  <div class="form-field">
                    <label class="form-label" for="contact_veil_length">Veil Length <span style="color:var(--ls-blush);">*</span></label>
                    <div style="position:relative;">
                      <select class="form-select" id="contact_veil_length" name="contact[veil length]" required style="padding-right:28px;">
                        <option value="" disabled selected>Select</option>
                        <option>Blusher</option>
                        <option>Elbow</option>
                        <option>Fingertip</option>
                        <option>Waltz / Ballet</option>
                        <option>Chapel</option>
                        <option>Cathedral</option>
                        <option>Royal / Monarch</option>
                        <option>Custom / Not sure</option>
                      </select>
                      <span style="position:absolute;right:0;top:50%;transform:translateY(-50%);color:var(--ls-ink-60);pointer-events:none;">{%- render 'icon-chevron-down', size: 14 -%}</span>
                    </div>
                  </div>
                  <div class="form-field">
                    <label class="form-label" for="contact_custom_length">Custom Veil Length</label>
                    <input class="form-input" type="text" id="contact_custom_length" name="contact[custom veil length]">
                  </div>
                  <div class="form-field">
                    <label class="form-label" for="contact_blusher">Would you like a blusher? (A layer that can be worn over your face)</label>
                    <div style="position:relative;">
                      <select class="form-select" id="contact_blusher" name="contact[blusher]" style="padding-right:28px;">
                        <option value="" disabled selected>Select</option>
                        <option>Yes</option>
                        <option>No</option>
                        <option>Not sure</option>
                      </select>
                      <span style="position:absolute;right:0;top:50%;transform:translateY(-50%);color:var(--ls-ink-60);pointer-events:none;">{%- render 'icon-chevron-down', size: 14 -%}</span>
                    </div>
                  </div>
                  <div class="form-field form-field--full">
                    <label class="form-label" style="margin-bottom:10px;">Please choose any embellishments you are interested in.</label>
                    <div style="display:flex;flex-direction:column;gap:10px;">
                      <label style="display:flex;align-items:center;gap:10px;font-size:14px;cursor:pointer;"><input type="checkbox" data-group="embellishments" value="Pearls" style="flex-shrink:0;"> <span>Pearls</span></label>
                      <label style="display:flex;align-items:center;gap:10px;font-size:14px;cursor:pointer;"><input type="checkbox" data-group="embellishments" value="Partial Lace Trim" style="flex-shrink:0;"> <span>Partial Lace Trim</span></label>
                      <label style="display:flex;align-items:center;gap:10px;font-size:14px;cursor:pointer;"><input type="checkbox" data-group="embellishments" value="Full Lace Trim" style="flex-shrink:0;"> <span>Full Lace Trim</span></label>
                      <label style="display:flex;align-items:center;gap:10px;font-size:14px;cursor:pointer;"><input type="checkbox" data-group="embellishments" value="Lace Applique" style="flex-shrink:0;"> <span>Lace Applique</span></label>
                      <label style="display:flex;align-items:center;gap:10px;font-size:14px;cursor:pointer;"><input type="checkbox" data-group="embellishments" value="Swarovski Crystals" style="flex-shrink:0;"> <span>Swarovski Crystals</span></label>
                      <label style="display:flex;align-items:center;gap:10px;font-size:14px;cursor:pointer;"><input type="checkbox" data-group="embellishments" value="Other" style="flex-shrink:0;"> <span>Other</span></label>
                    </div>
                    <input type="hidden" name="contact[embellishments interested in]" id="embellishments_val">
                  </div>
                  <div class="form-field form-field--full">
                    <label class="form-label">Inspiration images</label>
                    <p style="font-size:13px;color:var(--ls-ink-60);margin-bottom:10px;line-height:1.5;">Please feel welcome to share photos of your gown and any inspiration images you have collected. Paste links from Pinterest, Instagram, or anywhere you have saved your vision.</p>
                    <textarea class="form-textarea" name="contact[inspiration links]" rows="3" placeholder="Paste Pinterest, Instagram or any image links here"></textarea>
                  </div>
                </div>
              </div>

              {%- comment -%} 05 — Custom Embroidery {%- endcomment -%}
              <div class="form-section">
                <div class="form-section-header">
                  <span class="form-section-num">05</span>
                  <h3 class="form-section-title"><em>Custom Embroidery</em></h3>
                  <div class="form-section-rule"></div>
                </div>
                <div style="display:flex;flex-direction:column;gap:20px;">
                  <div class="form-field form-field--full">
                    <label class="form-label" style="margin-bottom:10px;">Would you like to personalise your veil with custom embroidery? <span style="color:var(--ls-blush);">*</span></label>
                    <div style="display:flex;gap:24px;">
                      <label style="display:flex;align-items:center;gap:8px;font-size:14px;cursor:pointer;"><input type="radio" name="contact[custom embroidery]" value="Yes" required> <span>Yes</span></label>
                      <label style="display:flex;align-items:center;gap:8px;font-size:14px;cursor:pointer;"><input type="radio" name="contact[custom embroidery]" value="No" required> <span>No</span></label>
                    </div>
                  </div>
                  <div class="form-field form-field--full">
                    <label class="form-label" style="margin-bottom:10px;">Embroidery size preference</label>
                    <div style="display:flex;gap:24px;flex-wrap:wrap;">
                      <label style="display:flex;align-items:center;gap:8px;font-size:14px;cursor:pointer;"><input type="checkbox" data-group="embroidery-size" value="Less than 25cm / 10 inches" style="flex-shrink:0;"> <span>Less than 25cm / 10 inches</span></label>
                      <label style="display:flex;align-items:center;gap:8px;font-size:14px;cursor:pointer;"><input type="checkbox" data-group="embroidery-size" value="Larger, statement-style design" style="flex-shrink:0;"> <span>Larger, statement-style design</span></label>
                    </div>
                    <input type="hidden" name="contact[embroidery size]" id="embroidery_size_val">
                  </div>
                  <div class="form-field form-field--full">
                    <label class="form-label" style="margin-bottom:10px;">What would you like embroidered?</label>
                    <div style="display:flex;flex-direction:column;gap:10px;">
                      <label style="display:flex;align-items:flex-start;gap:10px;font-size:14px;cursor:pointer;"><input type="checkbox" data-group="embroidery-type" value="Names" style="flex-shrink:0;margin-top:2px;"> <span>Names (e.g., Emma &amp; Riley)</span></label>
                      <label style="display:flex;align-items:flex-start;gap:10px;font-size:14px;cursor:pointer;"><input type="checkbox" data-group="embroidery-type" value="Initials" style="flex-shrink:0;margin-top:2px;"> <span>Initials (e.g., E &amp; R)</span></label>
                      <label style="display:flex;align-items:flex-start;gap:10px;font-size:14px;cursor:pointer;"><input type="checkbox" data-group="embroidery-type" value="Wedding Date" style="flex-shrink:0;margin-top:2px;"> <span>Wedding Date</span></label>
                      <label style="display:flex;align-items:flex-start;gap:10px;font-size:14px;cursor:pointer;"><input type="checkbox" data-group="embroidery-type" value="Future Mrs / Almost Mrs" style="flex-shrink:0;margin-top:2px;"> <span>Future Mrs / Almost Mrs</span></label>
                      <label style="display:flex;align-items:flex-start;gap:10px;font-size:14px;cursor:pointer;"><input type="checkbox" data-group="embroidery-type" value="Meaningful quote or phrase" style="flex-shrink:0;margin-top:2px;"> <span>Meaningful quote or phrase (e.g., It Was Always You, Forever &amp; Always, Till Death Do Us Part)</span></label>
                      <label style="display:flex;align-items:flex-start;gap:10px;font-size:14px;cursor:pointer;"><input type="checkbox" data-group="embroidery-type" value="Other" style="flex-shrink:0;margin-top:2px;"> <span>Other (please provide more information below)</span></label>
                    </div>
                    <input type="hidden" name="contact[embroidery type]" id="embroidery_type_val">
                  </div>
                  <div class="form-field form-field--full">
                    <label class="form-label" for="contact_embroidery_text">Please confirm what you would like embroidered so I can provide a mock-up in your proposal.</label>
                    <textarea class="form-textarea" id="contact_embroidery_text" name="contact[embroidery detail]" rows="3" placeholder="Eg. Forever And Always / S+R / 11.02.26"></textarea>
                  </div>
                </div>
              </div>

              {%- comment -%} 06 — Budget and final notes {%- endcomment -%}
              <div class="form-section">
                <div class="form-section-header">
                  <span class="form-section-num">06</span>
                  <h3 class="form-section-title">Budget &amp; final notes</h3>
                  <div class="form-section-rule"></div>
                </div>
                <div style="display:flex;flex-direction:column;gap:24px;">
                  <div class="form-field form-field--full">
                    <label class="form-label" for="contact_budget">Budget</label>
                    <p style="font-size:13px;color:var(--ls-ink-60);margin-bottom:8px;line-height:1.5;">You are welcome to indicate the budget you would like to dedicate to your veil, so I can offer options that beautifully reflect your style while respecting your investment.</p>
                    <input class="form-input" type="text" id="contact_budget" name="contact[budget]" placeholder="Optional, but helpful in recommending options that align with your vision and priorities.">
                  </div>
                  <div class="form-field form-field--full">
                    <label class="form-label" for="contact_why_custom">Is there a reason you are seeking out a custom made piece, rather than off-the-rack?</label>
                    <input class="form-input" type="text" id="contact_why_custom" name="contact[why custom]" placeholder="Sharing what is most important to you will help me create a veil design that reflects your story">
                  </div>
                  <div class="form-field form-field--full">
                    <label class="form-label" for="contact_additional">Additional details</label>
                    <p style="font-size:13px;color:var(--ls-ink-60);margin-bottom:10px;line-height:1.5;">Please share any additional details about your style or must-haves for your dream veil — whether it is a particular look that inspires you, a meaningful detail you would like included, or special considerations such as incorporating heirloom lace. If you are unsure about any of the options above, feel free to leave your questions here, and I would be delighted to offer personalised guidance and recommendations.</p>
                    <textarea class="form-textarea" id="contact_additional" name="contact[body]" rows="5"></textarea>
                  </div>
                </div>
              </div>

              {%- comment -%} Closing note from Jess {%- endcomment -%}
              <div style="border-top:1px solid var(--ls-border);padding-top:32px;">
                <p style="font-family:var(--ls-font-display);font-size:32px;font-style:italic;color:var(--ls-charcoal);margin-bottom:16px;">Thank You!</p>
                <p style="font-size:14px;line-height:1.8;color:var(--ls-ink-82);">
                  In the meantime, feel free to follow along on Instagram and TikTok @lovestoryatelier for behind-the-scenes, real bride features, and inspiration.<br>
                  I am so looking forward to reviewing your request and bringing your vision to life.
                </p>
                <p style="font-size:16px;font-style:italic;color:var(--ls-charcoal);margin-top:16px;">Jess x</p>
              </div>

              <div class="form-footer-strip">
                <label class="form-consent">
                  <input type="checkbox" required>
                  <span>I agree to be contacted about my veil enquiry. Love Story Atelier keeps your details privately — never shared, never resold.</span>
                </label>
                <div class="form-submit-row">
                  <button type="submit" class="btn btn--primary btn--lg" data-submit-btn>
                    Submit {%- render 'icon-arrow-right', size: 15 -%}
                  </button>
                </div>
              </div>

            </div>
          {%- endif -%}
        {%- endform -%}
      </div>

    </div>
  </div>
</section>

<script>
document.getElementById('EnquiryForm')?.addEventListener('submit', function() {
  var collect = function(groupName, hiddenId) {
    var vals = [];
    document.querySelectorAll('[data-group="' + groupName + '"]:checked').forEach(function(cb) {
      vals.push(cb.value);
    });
    var hidden = document.getElementById(hiddenId);
    if (hidden) hidden.value = vals.join(', ');
  };
  collect('accessories', 'accessories_val');
  collect('embellishments', 'embellishments_val');
  collect('embroidery-size', 'embroidery_size_val');
  collect('embroidery-type', 'embroidery_type_val');
});
</script>

{% schema %}
{
  "name": "Enquiry form",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "aside_image", "label": "Aside photograph" },
    { "type": "text", "id": "reply_email", "label": "Reply-from email shown in success message", "default": "info@lovestoryatelier.com" }
  ],
  "presets": [
    { "name": "Enquiry form" }
  ]
}
{% endschema %}
