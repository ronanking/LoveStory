<div class="marquee-wrap" data-reveal>
  <div class="marquee-row">
    {%- assign phrases = "Hand-embroidered|European silk tulle|Made to order|Brisbane studio|Worldwide express|One bride at a time|Couture finishing|Designed around your gown" | split: "|" -%}
    {%- comment -%} Repeat 3× for seamless loop {%- endcomment -%}
    {%- for rep in (1..3) -%}
      {%- for phrase in phrases -%}
        <span class="marquee-item">
          <span class="marquee-text">
            {%- assign mod_val = forloop.index0 | modulo: 2 -%}
            {%- if mod_val == 0 -%}
              {{ phrase }}
            {%- else -%}
              <em>{{ phrase }}</em>
            {%- endif -%}
          </span>
          <span class="marquee-star" aria-hidden="true">✦</span>
        </span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Value marquee",
  "tag": "div",
  "presets": [
    { "name": "Value marquee" }
  ]
}
{% endschema %}
