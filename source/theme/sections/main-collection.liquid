            <div class="veil-card__edge">Finished with <em>hand-applied lace motifs</em></div>
            <div class="veil-card__footer"><span class="veil-card__mto">Made to order</span><span style="color:var(--ls-ink-60);">{%- render 'icon-arrow-up-right', size: 13 -%}</span></div>
          </div>
        </a>
        <a href="/pages/contact#enquiry" class="veil-card" data-veil-card data-tags="Mantilla,Lace">
          <div class="ls-photo veil-card__img" style="aspect-ratio:3/4;">
            <img src="{{ 'ls-church-veil.jpg' | asset_url }}" alt="Mantilla · Church light dramatic drape" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:50% 25%;">
            <span class="ls-photo__eyebrow">Mantilla</span>
          </div>
          <div class="veil-card__body">
            <h3 class="veil-card__name">Mantilla · Silk Tulle</h3>
            <div class="veil-card__silhouette">Mantilla · 240 cm</div>
