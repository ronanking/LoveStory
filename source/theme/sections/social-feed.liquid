<section class="ls-section ls-section--veil" data-reveal>
  <div class="ls-container">
    <div class="ls-section-header" style="margin-bottom:48px;">
      <div style="display:flex;flex-direction:column;gap:12px;">
        <div class="ls-eyebrow">From the studio</div>
        <h2 class="ls-section-title">
          Quiet hours at the <em>atelier table</em>.
        </h2>
        <p class="ls-section-body">
          Embroidery close-ups, drape fittings, and brides wearing pieces we made together. Follow along.
        </p>
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;align-self:flex-end;">
        <a href="{{ section.settings.instagram_url }}" class="btn btn--ghost" target="_blank" rel="noopener">
          {%- render 'icon-instagram', size: 15 -%} @lovestoryatelier
        </a>
        <a href="{{ section.settings.tiktok_url }}" class="btn btn--ghost" target="_blank" rel="noopener">
          {%- render 'icon-tiktok', size: 15 -%} TikTok
        </a>
      </div>
    </div>

    <div class="social-grid">
      {%- for block in section.blocks -%}
        <a
          href="{{ block.settings.link | default: '#' }}"
          class="social-tile {% if block.settings.tall %}social-tile--tall{% else %}social-tile--square{% endif %}"
          target="_blank"
          rel="noopener"
          {{ block.shopify_attributes }}
        >
          <div class="ls-photo" style="position:absolute;inset:0;">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 600 }}"
                alt="{{ block.settings.label }}"
                loading="lazy"
                style="object-position:{{ block.settings.focal | default: '50% 40%' }};"
              >
            {%- endif -%}
          </div>
          <div class="social-tile__overlay"></div>
          <div class="social-tile__badge">
            {%- if block.settings.platform == "tiktok" -%}
              {%- render 'icon-tiktok', size: 12 -%}
            {%- else -%}
              {%- render 'icon-instagram', size: 13 -%}
            {%- endif -%}
          </div>
          <div class="social-tile__label">{{ block.settings.label }}</div>
        </a>
      {%- else -%}
        {%- assign ig = section.settings.instagram_url | default: 'https://instagram.com/lovestoryatelier' -%}
        <a href="{{ ig }}" class="social-tile social-tile--tall" target="_blank" rel="noopener">
          <div class="ls-photo" style="position:absolute;inset:0;"><img src="{{ 'ls-bride-cathedral.jpg' | asset_url }}" alt="Bride under cathedral veil golden hour" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:50% 20%;"></div>
          <div class="social-tile__overlay"></div>
          <div class="social-tile__badge">{%- render 'icon-instagram', size: 13 -%}</div>
          <div class="social-tile__label">Cathedral veil · golden hour · soft silk tulle</div>
        </a>
        <a href="{{ ig }}" class="social-tile social-tile--square" target="_blank" rel="noopener">
          <div class="ls-photo" style="position:absolute;inset:0;"><img src="{{ 'ls-golden-lace.jpg' | asset_url }}" alt="Couple golden hour lace mantilla" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:50% 30%;"></div>
          <div class="social-tile__overlay"></div>
          <div class="social-tile__badge">{%- render 'icon-instagram', size: 13 -%}</div>
          <div class="social-tile__label">Mantilla · full lace trim · golden hour</div>
        </a>
        <a href="{{ ig }}" class="social-tile social-tile--square" target="_blank" rel="noopener">
          <div class="ls-photo" style="position:absolute;inset:0;"><img src="{{ 'ls-bride-blusher.jpg' | asset_url }}" alt="Bride with blusher cap veil" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:50% 25%;"></div>
          <div class="social-tile__overlay"></div>
          <div class="social-tile__badge">{%- render 'icon-instagram', size: 13 -%}</div>
          <div class="social-tile__label">Blusher cap veil · lace edge · European tulle</div>
        </a>
        <a href="{{ ig }}" class="social-tile social-tile--square" target="_blank" rel="noopener">
          <div class="ls-photo" style="position:absolute;inset:0;"><img src="{{ 'ls-veil-bw.jpg' | asset_url }}" alt="Couple under veil church light" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:50% 30%;"></div>
          <div class="social-tile__overlay"></div>
          <div class="social-tile__badge">{%- render 'icon-instagram', size: 13 -%}</div>
          <div class="social-tile__label">Mantilla · Chantilly lace · church light</div>
        </a>
        <a href="{{ ig }}" class="social-tile social-tile--square" target="_blank" rel="noopener">
          <div class="ls-photo" style="position:absolute;inset:0;"><img src="{{ 'ls-mantilla-couple.jpg' | asset_url }}" alt="Happy couple lace mantilla veil" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:50% 30%;"></div>
          <div class="social-tile__overlay"></div>
          <div class="social-tile__badge">{%- render 'icon-instagram', size: 13 -%}</div>
          <div class="social-tile__label">Lace mantilla · real bride · sunset</div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Social feed",
  "tag": "div",
  "blocks": [
    {
      "type": "post",
      "name": "Social post",
      "settings": [
        { "type": "image_picker", "id": "image",    "label": "Photo" },
        { "type": "text",         "id": "label",    "label": "Caption" },
        { "type": "url",          "id": "link",     "label": "Post URL" },
        { "type": "select",       "id": "platform", "label": "Platform", "options": [{"value":"instagram","label":"Instagram"},{"value":"tiktok","label":"TikTok"}], "default": "instagram" },
        { "type": "checkbox",     "id": "tall",     "label": "Tall (9:16 ratio)", "default": false },
        { "type": "text",         "id": "focal",    "label": "Focal point", "default": "50% 40%" }
      ]
    }
  ],
  "settings": [
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "tiktok_url",    "label": "TikTok URL" }
  ],
  "presets": [
    { "name": "Social feed" }
  ]
}
{% endschema %}
