            <img src="{{ 'ls-lace-closeup.jpg' | asset_url }}" alt="Fingertip Veil · Chantilly lace detail" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:50% 40%;">
            <span class="ls-photo__eyebrow">Fingertip</span>
          </div>
          <div class="veil-card__body">
            <h3 class="veil-card__name">Fingertip · Chantilly Detail</h3>
