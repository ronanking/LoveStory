<section class="ls-section ls-section--veil" data-reveal>
  <div class="ls-container">
    <div style="text-align:center;max-width:760px;margin:0 auto 64px;">
      <div class="ls-eyebrow">What we believe</div>
      <h2 class="ls-section-title" style="margin-top:14px;">
        Three principles, <em>quietly held</em>.
      </h2>
    </div>
    <div class="values-grid">
      <div class="value-card">
        <div class="value-card__num">01</div>
        <div class="ls-eyebrow" style="color:var(--ls-ink-60);">Made by hand</div>
        <h3 class="value-card__title">European tulle · finished in Brisbane</h3>
        <p class="value-card__body">Every veil is cut, draped, hemmed, and embroidered in the studio. Luxurious European tulle, hand-finished edges, archival care wrap.</p>
      </div>
      <div class="value-card">
        <div class="value-card__num">02</div>
        <div class="ls-eyebrow" style="color:var(--ls-ink-60);">Made for you</div>
        <h3 class="value-card__title">Drafted around your gown</h3>
        <p class="value-card__body">Length, silhouette, and edge are chosen together — designed to complement your dress and tell your individual story.</p>
      </div>
      <div class="value-card">
        <div class="value-card__num">03</div>
        <div class="ls-eyebrow" style="color:var(--ls-ink-60);">Made to keep</div>
        <h3 class="value-card__title">Heirloom-quality pieces</h3>
        <p class="value-card__body">Couture craftsmanship and dedication to handcrafted excellence — pieces you'll treasure long after the day is done.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Atelier values",
  "tag": "div",
  "presets": [
    { "name": "Atelier values" }
  ]
}
{% endschema %}
